  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "The app's name as iOS shows it, on the Home Screen and in the Shortcuts button on onboarding's Siri and Shortcuts step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
