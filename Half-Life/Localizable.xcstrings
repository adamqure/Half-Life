{
  "sourceLanguage" : "en",
  "strings" : {
    "–" : {
      "comment" : "Shown in place of a group's average resting heart rate while it has no days."
    },
    "“Ask Half-Life a question”" : {
      "comment" : "Onboarding's Siri and Shortcuts step: a phrase to try with Siri. It must match a phrase in AppShortcuts.xcstrings."
    },
    "“How much caffeine is in me in Half-Life?”" : {
      "comment" : "Onboarding's Siri and Shortcuts step: a phrase to try with Siri. It must match a phrase in AppShortcuts.xcstrings."
    },
    "“Log a latte in Half-Life”" : {
      "comment" : "Onboarding's Siri and Shortcuts step: a phrase to try with Siri. It must match a phrase in AppShortcuts.xcstrings."
    },
    "“When should I go to sleep in Half-Life?”" : {
      "comment" : "Onboarding's Siri and Shortcuts step: a phrase to try with Siri. It must match a phrase in AppShortcuts.xcstrings."
    },
    "%@" : {

    },
    "%@ – %@" : {
      "comment" : "Insights: tonight's sleep window, from its start to its end. The arguments are clock times, such as \"12:24 AM\" and \"1:54 AM\"."
    },
    "%@ · %@" : {
      "comment" : "A one-tap favourite's quantity and caffeine. The first argument is the quantity with its unit, such as \"2 shots\", and the second is the caffeine, such as \"125 mg\"."
    },
    "%@ (%@) at %@" : {
      "comment" : "App Intents: one drink in Siri's list of a day's drinks. The arguments are the drink, such as \"Latte\", its quantity, such as \"2 shots\", and when it was drunk, such as \"8:10 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@) at %3$@"
          }
        }
      }
    },
    "%@ (%@) at %@, from the demo data" : {
      "comment" : "App Intents: one demo drink in Siri's list of a day's drinks. The arguments are the drink, its quantity, and when it was drunk.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@) at %3$@, from the demo data"
          }
        }
      }
    },
    "%@ ago" : {
      "comment" : "The drink was consumed this long ago. The argument is a short duration, such as \"1h\"."
    },
    "%@ is where your time asleep starts to drop, from the trend in your recent nights." : {

    },
    "%@ logged" : {
      "comment" : "App Intents: how Shortcuts shows the intake value. The argument is an amount, such as \"290 mg\"."
    },
    "%@ now" : {
      "comment" : "App Intents: how Shortcuts shows the caffeine-level value. The argument is an amount, such as \"85 mg\"."
    },
    "%@ or less" : {
      "comment" : "The chart legend for the hollow dots on the resting heart rate screen: nights with caffeine at or under the threshold. %@ is the sleep threshold, such as \"40 mg\"."
    },
    "%@ per can" : {
      "comment" : "A drink's caffeine in one can. The argument is an amount, such as \"34 mg\"."
    },
    "%@ per cup" : {
      "comment" : "A drink's caffeine in one 8 fl oz cup. The argument is an amount, such as \"95 mg\"."
    },
    "%@ per shot" : {
      "comment" : "A drink's caffeine in one espresso shot. The argument is an amount, such as \"63 mg\"."
    },
    "%@ steps" : {
      "comment" : "Insights, steps screen: one side's average steps, such as \"8,420 steps\"."
    },
    "%@ steps over %lld days" : {
      "comment" : "Insights, steps screen: VoiceOver's reading of one side of the comparison, such as \"8,420 steps over 30 days\". The arguments are the average steps and the day count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ steps over %#@days@"
          },
          "substitutions" : {
            "days" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg day"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg days"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Accessibility label of a one-tap favourite. The first argument is the drink's name, such as \"Espresso\", and the second is its quantity, such as \"2 shots\"."
    },
    "%@, in bed %@" : {
      "comment" : "Accessibility value of a day's column on the Insights tab's last 7 days card, for a night with time in bed but no sleep recorded. The arguments are the day's caffeine and the time in bed."
    },
    "%@, slept %@" : {
      "comment" : "Accessibility value of a day's column on the Insights tab's last 7 days card. The arguments are the day's caffeine, such as \"63 milligrams\", and the night's time asleep, such as \"7 hours\"."
    },
    "%lld beats per minute higher" : {
      "comment" : "VoiceOver's reading of the resting heart rate screen's headline difference, such as \"3 beats per minute higher\"."
    },
    "%lld beats per minute lower" : {
      "comment" : "VoiceOver's reading of the resting heart rate screen's headline difference, such as \"2 beats per minute lower\"."
    },
    "%lld beats per minute on average, %@" : {
      "comment" : "VoiceOver's reading of a group's average on the resting heart rate screen. %@ is how many days it has, such as \"9 days\"."
    },
    "%lld bpm" : {
      "comment" : "Today's resting heart rate on the Apple Health card, in beats per minute, such as \"58 bpm\"."
    },
    "%lld cans" : {
      "comment" : "How many cans of the chosen drink.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld can"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cans"
                }
              }
            }
          }
        }
      }
    },
    "%lld cups" : {
      "comment" : "How many cups of the chosen drink.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cup"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cups"
                }
              }
            }
          }
        }
      }
    },
    "%lld days" : {
      "comment" : "Insights, steps screen: how many days one side's average covers.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld day"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld days"
                }
              }
            }
          }
        }
      }
    },
    "%lld nights" : {
      "comment" : "Insights, sleep screen: how many nights an average, or a chart, covers.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld night"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld nights"
                }
              }
            }
          }
        }
      }
    },
    "%lld shots" : {
      "comment" : "How many espresso shots of the chosen drink.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld shot"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld shots"
                }
              }
            }
          }
        }
      }
    },
    "%lld–%lld hours" : {
      "comment" : "Onboarding's summary: the range of sleep recommended for the user's age. The arguments are the least and the most, in whole hours."
    },
    "A %@, %@, now still clears by your %@ bedtime. After this, caffeine will still be in you when you go to bed." : {
      "comment" : "The cutoff reminder's notification, at the latest time the usual drink still fits before bedtime. The arguments are the drink's name, such as \"Latte\", its quantity, such as \"2 shots\", and the bedtime, such as \"10:30 PM\"."
    },
    "A caffeine night is one with more than your recommended caffeine in you when you fell asleep, or at your bedtime if Apple Health has no sleep that night." : {
      "comment" : "Insights, steps screen: defines a caffeine night, under the averages. \"Your recommended caffeine\" is the sleep threshold, the most caffeine the app recommends having in you at bedtime."
    },
    "A pattern in your own days, not proof that caffeine caused it. Resting heart rate also moves with exercise, illness, alcohol, and stress." : {
      "comment" : "The resting heart rate screen's footnote on what the comparison can't claim."
    },
    "A pattern in your own nights, not proof that caffeine caused it." : {
      "comment" : "Insights, sleep screen: the footnote, so the screen doesn't claim more than a correlation."
    },
    "About %@ fewer steps after a caffeine night" : {
      "comment" : "Insights, steps screen: the verdict when days after a caffeine night had clearly fewer steps. The argument is the difference, rounded to the nearest hundred, such as \"1,500\"."
    },
    "About %@ in your system now." : {
      "comment" : "App Intents: Siri's reply for the caffeine level, when there's no bedtime to add. The argument is an amount, such as \"85 mg\"."
    },
    "About %@ in your system now. Down to about %@ by %@." : {
      "comment" : "App Intents: Siri's reply for the caffeine level. The arguments are the amount now, the amount at bedtime, and the bedtime, such as \"85 mg\", \"34 mg\", and \"10:30 PM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About %1$@ in your system now. Down to about %2$@ by %3$@."
          }
        }
      }
    },
    "About %@ more steps after a caffeine night" : {
      "comment" : "Insights, steps screen: the verdict when days after a caffeine night had clearly more steps. The argument is the difference, rounded to the nearest hundred, such as \"1,500\"."
    },
    "About %@ would still be in you at your %@ bedtime. Clinical sleep studies support under %@ for the average person." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About %1$@ would still be in you at your %2$@ bedtime. Clinical sleep studies support under %3$@ for the average person."
          }
        }
      }
    },
    "About %@ would still be in you at your %@ bedtime. Your time asleep starts to drop above %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About %1$@ would still be in you at your %2$@ bedtime. Your time asleep starts to drop above %3$@."
          }
        }
      }
    },
    "About you" : {
      "comment" : "Onboarding: the title of the step that asks for the name and age."
    },
    "Add %@" : {
      "comment" : "Logs the chosen drink. The argument is its caffeine, such as \"125 mg\"."
    },
    "Add 30 days of demo drinks" : {
      "comment" : "Settings: the button that adds 30 days of sample drinks to the log."
    },
    "Added" : {
      "comment" : "Settings: the Demo data row's value while the log holds demo drinks."
    },
    "Adds 30 days of sample drinks, up to now, so your history and caffeine curve have something to show. Each one is labeled Demo in your history. Removing them keeps the drinks you logged." : {
      "comment" : "Settings: under the sample drinks' button. It says what they are and what removing them keeps."
    },
    "After a caffeine night" : {
      "comment" : "Insights, steps screen: the label over the average steps on days after a night with more than the sleep threshold of caffeine in the body at sleep."
    },
    "After a caffeine night: %@. Other days: %@." : {
      "comment" : "Insights, steps screen: VoiceOver's value for the chart. Each argument is one side, such as \"8,420 steps over 30 days\", or \"none yet\"."
    },
    "After nights that began with over %@ of caffeine, your resting heart rate stayed within its usual day-to-day range." : {
      "comment" : "Under the resting heart rate screen's \"No clear difference\" headline. %@ is the sleep threshold, such as \"40 mg\"."
    },
    "After nights that began with over %@ of caffeine: %@. After other nights: %@." : {
      "comment" : "VoiceOver's summary of the resting heart rate screen's chart. The first %@ is the sleep threshold, such as \"40 milligrams\"; the others are each group's average, such as \"61 beats per minute on average, 9 days\"."
    },
    "After other nights" : {
      "comment" : "The resting heart rate screen's label for the days after the other nights."
    },
    "After your cutoff" : {
      "comment" : "The heading of the drink composer's warning, when the chosen drink, at the time chosen, is past its caffeine cutoff."
    },
    "Against your caffeine" : {
      "comment" : "Insights: the heading of the card with a button for each kind of Apple Health data."
    },
    "Age" : {
      "comment" : "Onboarding's About you step: the label of the age picker."
    },
    "Allow" : {
      "comment" : "Onboarding: a permission row's button that asks for the permission."
    },
    "Allow %@" : {
      "comment" : "Accessibility: the Face ID or Touch ID row's Allow button, read by VoiceOver. The argument is \"Face ID\", \"Touch ID\", or \"Optic ID\"."
    },
    "Allow %@ for Half-Life in the Settings app to turn the lock on." : {
      "comment" : "Settings' App lock section: why the lock can't be turned on while the user has said no to Face ID. The argument is \"Face ID\", \"Touch ID\", or \"Optic ID\"."
    },
    "Allow Apple Health" : {
      "comment" : "Accessibility: the Apple Health row's Allow button, read by VoiceOver."
    },
    "Allow Half-Life to check that it's you." : {
      "comment" : "Touch ID prompt's reason when Half-Life asks to use biometrics, which the app lock uses."
    },
    "Allow notifications" : {
      "comment" : "Accessibility: the notifications row's Allow button, read by VoiceOver."
    },
    "Americano" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Answers a question about your caffeine, using Apple Intelligence on your iPhone." : {
      "comment" : "App Intents: what the Ask Half-Life action does, shown in Shortcuts."
    },
    "Answers need Apple Intelligence. Open Half-Life to see your caffeine?" : {
      "comment" : "App Intents: Siri asks this when Ask Half-Life can't answer because Apple Intelligence is unavailable."
    },
    "App lock" : {
      "comment" : "Settings: the title of the section that turns the app lock on or off."
    },
    "Apple Health" : {
      "comment" : "Onboarding: the Apple Health permission's name, on its row and in the summary."
    },
    "Apple Health hasn't recorded when you got into bed, so the time you took to fall asleep can't be measured." : {
      "comment" : "Insights, sleep screen: the time to fall asleep card, when no night has time in bed."
    },
    "appView.tab.insights" : {
      "comment" : "The Insights tab's title in the tab bar. The key is AppTab.insights's raw value, and the UI tests find the tab by this text.",
