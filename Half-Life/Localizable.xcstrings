    },
    "Ask Half-Life" : {
      "comment" : "App Intents: the Ask Half-Life action's name in Shortcuts, and its App Shortcut's title."
    },
    "Asked" : {
      "comment" : "Onboarding: Apple Health's status once it has been asked. iOS doesn't tell the app what the user allowed, so it can't say more."
    },
    "Asleep by" : {
      "comment" : "Onboarding's summary: the label of the bedtime, such as \"10:30 PM\"."
    },
    "At or under %@" : {
      "comment" : "Insights, sleep screen: the nights whose caffeine at sleep onset was at or under the threshold, in the averages and the chart's legend. The argument is the threshold, such as \"40 mg\"."
    },
    "Bedtime" : {
      "comment" : "The title of Settings' Bedtime screen, and the bedtime time picker's label there and in onboarding."
    },
    "Best time to sleep tonight" : {
      "comment" : "Insights: the heading of the card with tonight's 90-minute window to fall asleep in."
    },
    "Black tea" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Both are optional. Your name is for the greeting, and your age sets how much sleep Half-Life compares yours with." : {
      "comment" : "Onboarding's About you step: why it asks for the name and age."
    },
    "bpm" : {
      "comment" : "The unit beside the resting heart rate screen's headline difference, such as \"+3 bpm\": beats per minute."
    },
    "By %@" : {
      "comment" : "The Today screen's \"Last cup\" tile: the latest time to have the usual drink and still leave little enough caffeine at bedtime. The argument is a clock time, such as \"1:06 PM\"."
    },
    "Caffeine" : {
      "comment" : "Accessibility: the decay curve's vertical axis, the caffeine in the body in milligrams. Also the label of the chosen day's caffeine on the Insights tab's last 7 days card."
    },
    "Caffeine (mg)" : {
      "comment" : "App Intents: a property of the intake value, in Shortcuts: the day's caffeine, in milligrams."
    },
    "Caffeine and your body" : {
      "comment" : "Onboarding: the title of the step that asks what changes how fast the user clears caffeine."
    },
    "Caffeine at bedtime (mg)" : {
      "comment" : "App Intents: a property of the caffeine-level value, in Shortcuts: the caffeine at bedtime, in milligrams."
    },
    "Caffeine at sleep onset" : {
      "comment" : "Insights, sleep screen: the title of the charts' horizontal axis."
    },
    "Caffeine clears" : {
      "comment" : "App Intents: a property of the sleep-time value, in Shortcuts: when caffeine falls under the sleep threshold."
    },
    "Caffeine clears more slowly as a pregnancy goes on." : {
      "comment" : "Onboarding: the detail under the pregnancy option."
    },
    "Caffeine Intake" : {
      "comment" : "App Intents: the intake App Shortcut's title, and the name of the value the action returns."
    },
    "Caffeine is measured when Apple Health recorded you falling asleep. For nights with no sleep recorded, it's measured at your bedtime: %lld of %lld." : {
      "comment" : "The resting heart rate screen's footnote when some nights had no recorded sleep. The numbers are how many nights were measured at the bedtime, and how many days there are."
    },
    "Caffeine Level" : {
      "comment" : "App Intents: the caffeine-level App Shortcut's title, and the name of the value the action returns."
    },
    "Caffeine now (mg)" : {
      "comment" : "App Intents: a property of the caffeine-level value, in Shortcuts: the caffeine in the body now, in milligrams."
    },
    "Caffeine over the day" : {
      "comment" : "Accessibility label of the Today screen's decay curve, which spans 12 hours either side of now. On the In your system Home Screen widget, the curve spans 6 hours either side of now."
    },
    "Caffeine should be under %@ by your %@ bedtime." : {
      "comment" : "Insights: why tonight's sleep window starts at bedtime. The arguments are the sleep threshold, such as \"40 mg\", and the bedtime, such as \"10:30 PM\"."
    },
    "Caffeine should drop under %@ at about %@, after your %@ bedtime." : {
      "comment" : "Insights: why tonight's sleep window starts after bedtime. The arguments are the sleep threshold, such as \"40 mg\", when caffeine drops under it, such as \"12:24 AM\", and the bedtime, such as \"10:30 PM\"."
    },
    "Caffeine should stay over %@ until after noon tomorrow, so there's no good time to fall asleep tonight." : {
      "comment" : "App Intents: Siri's reply for the sleep time when caffeine doesn't clear. The argument is the sleep threshold, such as \"40 mg\"."
    },
    "Caffeine should stay over %@ until after noon tomorrow." : {
      "comment" : "Insights: why there's no sleep window tonight. The argument is the sleep threshold, such as \"40 mg\"."
    },
    "Caffeine tonight" : {
      "comment" : "Accessibility label of the Insights tab's chart of tonight's caffeine, from 6 PM to 4 AM or later."
    },
    "Cappuccino" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Change %@ in Settings" : {
      "comment" : "Accessibility: the Face ID or Touch ID row's Open Settings button. The argument is \"Face ID\", \"Touch ID\", or \"Optic ID\"."
    },
    "Change notifications in Settings" : {
      "comment" : "Accessibility: the notifications row's Open Settings button, read by VoiceOver."
    },
    "Change what Half-Life reads in the Health app." : {
      "comment" : "Onboarding: the note under Apple Health's status, once it has been asked."
    },
    "Close" : {
      "comment" : "Closes the drink composer without logging."
    },
    "Cola" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Cold brew" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Continue" : {
      "comment" : "Onboarding: the button that saves a step and moves to the next one."
    },
    "Current time" : {
      "comment" : "Accessibility: the marker on the decay curve at the current time."
    },
    "Day" : {
      "comment" : "App Intents: the intake action's day parameter, and the day in the value it returns."
    },
    "Decrease quantity" : {
      "comment" : "Accessibility label: removes one unit of the chosen drink."
    },
    "Delete" : {
      "comment" : "Confirms deleting the drink waiting to be deleted, in the Today screen's history card."
    },
    "Delete %@ at %@" : {
      "comment" : "Accessibility label for a drink's delete button in the history card. The arguments are the drink's name (such as \"Latte\") and when it was consumed (such as \"9:15 AM\")."
    },
    "Deletes the demo drinks, and keeps the drinks you logged." : {
      "comment" : "Accessibility hint of Settings' button that removes the sample drinks."
    },
    "Demo" : {
      "comment" : "History card: the label on a sample drink that Settings added, so it isn't mistaken for one the user logged."
    },
    "Demo data" : {
      "comment" : "Settings: the title of the section that adds or removes sample drinks."
    },
    "Demo Health data" : {
      "comment" : "The Apple Health card's heading on the Today screen, when its data comes from the demo that Settings turns on, not from Apple Health."
    },
    "Demo heart rate and sleep" : {
      "comment" : "Where the resting heart rate screen's data comes from while Settings' demo Health data switch is on."
    },
    "Demo sleep data" : {
      "comment" : "Insights: under the last 7 days card, saying its sleep is made-up demo data, while the demo Health data switch is on. Also the footnote on the Sleep screen."
    },
    "Demo steps" : {
      "comment" : "Insights, steps screen: says the steps come from the demo data, not Apple Health."
    },
    "Do you walk less the day after a caffeine night?" : {
      "comment" : "Insights, steps screen: the question the screen answers, under its title."
    },
    "Down to about %@ by %@ — half of your last cup is gone by %@." : {
      "comment" : "The decay card's tips. The arguments are the caffeine left at bedtime (such as \"34 mg\"), the bedtime (such as \"10:30 PM\"), and when the last drink is down to half its caffeine."
    },
    "Down to about %@ by %@." : {
      "comment" : "The decay card's tip once the last drink is past half gone. The arguments are the caffeine left at bedtime (such as \"34 mg\") and the bedtime (such as \"10:30 PM\")."
    },
    "Drink" : {
      "comment" : "App Intents: the Log a Drink action's drink parameter, and the name Siri and Shortcuts use for a drink."
    },
    "Drinks" : {
      "comment" : "App Intents: a property of the intake value, in Shortcuts: how many drinks were logged that day."
    },
    "Drip coffee" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Each day" : {
      "comment" : "Insights, steps screen: the heading of the chart card, a bar for each day's steps."
    },
    "Each one is optional. Half-Life works without any of them." : {
      "comment" : "Onboarding: the lead of the permissions step."
    },
    "Energy drink" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Espresso" : {
      "comment" : "A drink in the drink composer's list."
    },
    "Face ID" : {
      "comment" : "The name of Apple's Face ID, on onboarding's permission row and summary."
